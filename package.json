{
  "name": "damagesim",
  "version": "0.1.0",
  "private": true,
  "description": "League of Legends damage simulator: champions, builds, runes, combos vs. a target. Web UI for humans, CLI + MCP server for AI agents.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "damagesim": "src/cli/main.ts"
  },
  "scripts": {
    "data:fetch": "node scripts/fetch-data.ts",
    "data:build": "node scripts/build-data.ts",
    "data": "node scripts/update-data.ts",
    "sim": "node src/cli/main.ts",
    "mcp": "node src/mcp/server.ts",
    "predev": "node scripts/gen-kit-index.ts",
    "dev": "vite",
    "build": "node scripts/gen-kit-index.ts && vite build",
    "preview": "vite preview",
    "test": "tsc --noEmit && node --test 'test/**/*.test.ts' && prettier --check .",
    "fmt": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check-kits": "node scripts/check-kits.ts",
    "wiki": "node scripts/fetch-wiki.ts",
    "audit": "node scripts/audit-wiki.ts",
    "audit:items": "node scripts/audit-items.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  }
}
